<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppName">Plus One Trainer</sys:String>
    <sys:String x:Key="AppTagline">One less hassle, one more convenience</sys:String>
    <sys:String x:Key="VersionLabel">1.0 Beta</sys:String>
    <sys:String x:Key="NavConvenience">⌂  Convenience</sys:String>
    <sys:String x:Key="NavChallenge">⚑  Challenge</sys:String>
    <sys:String x:Key="NavModes">▦  Hidden modes</sys:String>
    <sys:String x:Key="NavLab">⚗  Test workshop</sys:String>
    <sys:String x:Key="NavCheats">✦  Cheats</sys:String>
    <sys:String x:Key="NavVault">▣  Save vault</sys:String>
    <sys:String x:Key="NavSettings">⚙  Settings &amp; about</sys:String>

    <sys:String x:Key="StatusSearching">Looking for the game…</sys:String>
    <sys:String x:Key="StatusNotRunning">Game is not running</sys:String>
    <sys:String x:Key="StatusAttached">Attached · Steam GOTY 1.2.0.1096</sys:String>
    <sys:String x:Key="StatusUnsupported">Game found, but this build is not allow-listed</sys:String>
    <sys:String x:Key="StatusReadOnly">Read-only protection</sys:String>
    <sys:String x:Key="AttachNow">Detect again</sys:String>
    <sys:String x:Key="GameNeeded">Start Plants vs. Zombies first.</sys:String>
    <sys:String x:Key="BattleNeeded">This feature is available only during a battle.</sys:String>
    <sys:String x:Key="Success">Done</sys:String>
    <sys:String x:Key="Failed">Operation failed</sys:String>
    <sys:String x:Key="Confirm">Confirm</sys:String>
    <sys:String x:Key="Cancel">Cancel</sys:String>

    <sys:String x:Key="HomeTitle">Make the game effortless first</sys:String>
    <sys:String x:Key="HomeSubtitle">Everyday conveniences stay on the first page. Numeric cheats remain one level deeper.</sys:String>
    <sys:String x:Key="AdvancedPauseTitle">Advanced Pause</sys:String>
    <sys:String x:Key="AdvancedPauseDescription">Target behavior: freeze the battle while keeping seed selection, planting, shoveling, and Cob Cannon input. The unique Steam 1096 runtime signature still needs live verification, so the 1.0 candidate disables this safely and never guesses an address.</sys:String>
    <sys:String x:Key="AdvancedPauseOn">Resume battle</sys:String>
    <sys:String x:Key="AdvancedPauseOff">Awaiting signature verification</sys:String>
    <sys:String x:Key="AdvancedPauseBadge">Live test pending · no writes</sys:String>
    <sys:String x:Key="SpeedTitle">Game speed</sys:String>
    <sys:String x:Key="SpeedDescription">Changes frame duration only; 1.0× is the original speed.</sys:String>
    <sys:String x:Key="ApplySpeed">Apply speed</sys:String>
    <sys:String x:Key="ResetSpeed">Original speed</sys:String>
    <sys:String x:Key="AutoCollect">Auto-collect sun, coins, diamonds, chocolate, and gifts</sys:String>
    <sys:String x:Key="PauseOnFocusLoss">Use Advanced Pause on focus loss (pending verification)</sys:String>
    <sys:String x:Key="ConvenienceTitle">Convenience switches</sys:String>
    <sys:String x:Key="HealthBarsTitle">Lawn health bars</sys:String>
    <sys:String x:Key="HealthBarsDescription">Show durability above every plant and zombie. Zombie bars update with their moving position. Visible only while the game is foreground and in battle.</sys:String>
    <sys:String x:Key="HealthBarsReadOnly">External read-only overlay · health is never changed</sys:String>
    <sys:String x:Key="HealthBarsEnabled">Show health bars</sys:String>
    <sys:String x:Key="ZombieHealthBars">Zombie bars (follow movement)</sys:String>
    <sys:String x:Key="PlantHealthBars">Plant bars</sys:String>
    <sys:String x:Key="HotkeysTitle">Hotkeys</sys:String>
    <sys:String x:Key="HotkeyF3">F3　Advanced Pause (enabled after verification)</sys:String>
    <sys:String x:Key="HotkeyF4">F4　Original / last speed</sys:String>
    <sys:String x:Key="HotkeyF8">F8　Back up save now</sys:String>
    <sys:String x:Key="SafetyTitle">Safety rails are active</sys:String>
    <sys:String x:Key="SafetyDescription">Writes only to an allow-listed build, backs up before risky actions, restores code patches on exit, and never alters the game EXE.</sys:String>

    <sys:String x:Key="ChallengeTitle">Raise the difficulty on your terms</sys:String>
    <sys:String x:Key="ChallengeSubtitle">Works in first-run Adventure, replays, Survival, and Endless. Body and armor use the same durability rule.</sys:String>
    <sys:String x:Key="DifficultyEnabled">Enable challenge rules</sys:String>
    <sys:String x:Key="SpawnCount">Spawn count multiplier</sys:String>
    <sys:String x:Key="SpawnCountHint">1.0–10.0; fractional extras are distributed across a wave.</sys:String>
    <sys:String x:Key="SpawnSpeed">Spawn speed multiplier</sys:String>
    <sys:String x:Key="SpawnSpeedHint">Accelerates wave progression without changing overall game speed.</sys:String>
    <sys:String x:Key="Durability">Zombie durability multiplier</sys:String>
    <sys:String x:Key="DurabilityHint">Applies to body, helmet, shield, and flying health.</sys:String>
    <sys:String x:Key="ApplyChallenge">Apply challenge rules</sys:String>
    <sys:String x:Key="AdvancedSettings">Advanced settings (level 3)</sys:String>
    <sys:String x:Key="GrowthUnit">Growth interval</sys:String>
    <sys:String x:Key="GrowthNone">No growth</sys:String>
    <sys:String x:Key="GrowthWave">Every wave</sys:String>
    <sys:String x:Key="GrowthFlag">Every flag (10 waves)</sys:String>
    <sys:String x:Key="GrowthSelection">Every seed selection (20 waves / 2 flags)</sys:String>
    <sys:String x:Key="GrowthLevel">Every level</sys:String>
    <sys:String x:Key="GrowthFormula">Growth formula</sys:String>
    <sys:String x:Key="FormulaAdd">Fixed addition</sys:String>
    <sys:String x:Key="FormulaPercent">Percentage increase</sys:String>
    <sys:String x:Key="FormulaMultiply">Multiplicative</sys:String>
    <sys:String x:Key="GrowthStep">Growth value</sys:String>
    <sys:String x:Key="GrowthStarts">Start at interval</sys:String>
    <sys:String x:Key="GrowthCap">Multiplier cap</sys:String>
    <sys:String x:Key="ResetAtLevel">Reset growth on a new level</sys:String>
    <sys:String x:Key="ChallengeRuntimeNote">The safe Steam 1096 object transaction still needs a live test. Challenge-rule writes are disabled in this candidate; its UI and calculations remain ready for verification.</sys:String>

    <sys:String x:Key="ModesTitle">The other page hidden in the original</sys:String>
    <sys:String x:Key="ModesSubtitle">After completing Adventure once, reveal the original Limbo Page without editing profile unlock data.</sys:String>
    <sys:String x:Key="UnlockLimbo">Show Limbo Page</sys:String>
    <sys:String x:Key="LockLimbo">Hide it again</sys:String>
    <sys:String x:Key="LimboHow">Enable this, return to the main menu, then open the mini-game/survival selection screen to see the extra entry.</sys:String>
    <sys:String x:Key="StableModes">Original hidden modes, relatively stable</sys:String>
    <sys:String x:Key="StableModesList">Day Endless · Night Endless · Fog Endless · Roof Endless · Limbo mini-games</sys:String>
    <sys:String x:Key="OfficialPool">Pool Endless already appears on the normal Survival page.</sys:String>
    <sys:String x:Key="PuzzleInfo">Vasebreaker and I, Zombie stages 1–9 plus Endless belong to the normal Puzzle page, not a separate hidden page.</sys:String>
    <sys:String x:Key="ExperimentalModes">Experimental modes</sys:String>
    <sys:String x:Key="NightRoof">Night Roof Endless</sys:String>
    <sys:String x:Key="NightRoofDescription">The original has no complete NIGHT_ROOF_ENDLESS mode. This is a scene-mixing experiment, not a claimed hidden original level.</sys:String>
    <sys:String x:Key="ApplyNightRoof">Toggle Night Roof in Roof Endless</sys:String>
    <sys:String x:Key="InternalModes">Internal / unfinished entries</sys:String>
    <sys:String x:Key="InternalModesDescription">Ice Level, Zen Garden mode, Squirrel, Intro, Upsell, and similar entries may be unwinnable or crash. Version 1.0 does not offer one-click launch for them.</sys:String>

    <sys:String x:Key="LabTitle">Test workshop</sys:String>
    <sys:String x:Key="LabSubtitle">Place test objects in an I, Zombie-like workflow with battle, row-count, and special-zombie checks.</sys:String>
    <sys:String x:Key="ZombieSpawner">Place a zombie</sys:String>
    <sys:String x:Key="ZombieType">Zombie type</sys:String>
    <sys:String x:Key="Row">Row</sys:String>
    <sys:String x:Key="Column">Column</sys:String>
    <sys:String x:Key="SpawnZombie">Place one</sys:String>
    <sys:String x:Key="BossWarning">Dr. Zomboss ignores row/column and is limited to one in the native final-boss battle. Bobsled Team creates four native objects and is blocked in this candidate.</sys:String>
    <sys:String x:Key="LadderTool">Standalone ladder</sys:String>
    <sys:String x:Key="LadderDescription">This places the grid ladder, not a Ladder Zombie. The target cell must contain a Wall-nut, Tall-nut, or Pumpkin.</sys:String>
    <sys:String x:Key="PlaceLadder">Place ladder on target</sys:String>
    <sys:String x:Key="ClearLabObjects">Clear objects created this session</sys:String>
    <sys:String x:Key="ClearLabHint">Clears only zombies and ladders created by this tool during the current attachment; it does not wipe the lawn.</sys:String>
    <sys:String x:Key="InvalidLadderCell">No living Wall-nut, Tall-nut, or Pumpkin exists in the target cell.</sys:String>
    <sys:String x:Key="BossConfirmTitle">Confirm Dr. Zomboss spawn</sys:String>
    <sys:String x:Key="BossConfirmText">A save backup will be made first. Dr. Zomboss depends on special level scripts and may crash a normal scene. Place one anyway?</sys:String>

    <sys:String x:Key="CheatsTitle">Cheats</sys:String>
    <sys:String x:Key="CheatsSubtitle">These are not everyday conveniences, so they live one level deeper. Every patch can be restored independently.</sys:String>
    <sys:String x:Key="SunAmount">Sun amount</sys:String>
    <sys:String x:Key="SetSun">Set sun</sys:String>
    <sys:String x:Key="NoCooldown">No seed packet cooldown</sys:String>
    <sys:String x:Key="FreePlanting">Planting costs no sun</sys:String>
    <sys:String x:Key="PlantInvincible">Invincible plants (all covered damage sources)</sys:String>
    <sys:String x:Key="MushroomsAwake">Mushrooms stay awake during day</sys:String>
    <sys:String x:Key="UnlockSunLimit">Remove the 9,990 sun limit</sys:String>
    <sys:String x:Key="CheatWarning">The trainer restores code patches on a normal exit. If the game closes unexpectedly, its process memory disappears with it.</sys:String>

    <sys:String x:Key="VaultTitle">Save vault</sys:String>
    <sys:String x:Key="VaultSubtitle">No profile editing—only verified whole-directory backup and restore.</sys:String>
    <sys:String x:Key="SaveLocation">Detected save directory</sys:String>
    <sys:String x:Key="BackupNow">Create backup now</sys:String>
    <sys:String x:Key="OpenVault">Open vault folder</sys:String>
    <sys:String x:Key="RefreshBackups">Refresh list</sys:String>
    <sys:String x:Key="RestoreBackup">Restore selected backup</sys:String>
    <sys:String x:Key="NoBackups">No backups yet.</sys:String>
    <sys:String x:Key="RestoreWarning">The game must be closed. A fresh pre-restore snapshot is created automatically.</sys:String>
    <sys:String x:Key="RestoreConfirmTitle">Confirm save restore</sys:String>
    <sys:String x:Key="RestoreConfirmText">Files in the snapshot will be copied over the current save; extra current files outside that snapshot remain. A “before restore” snapshot is created first. Continue?</sys:String>
    <sys:String x:Key="BackupComplete">Save backup created.</sys:String>
    <sys:String x:Key="RestoreComplete">Files in the snapshot were restored and their hashes verified.</sys:String>

    <sys:String x:Key="SettingsTitle">Settings &amp; about</sys:String>
    <sys:String x:Key="SettingsSubtitle">Language, safety policy, compatible build, and public references.</sys:String>
    <sys:String x:Key="Language">Interface language</sys:String>
    <sys:String x:Key="Chinese">简体中文</sys:String>
    <sys:String x:Key="English">English</sys:String>
    <sys:String x:Key="Compatibility">Compatibility</sys:String>
    <sys:String x:Key="CompatibilityText">Version 1.0 enables writes only for English Steam GOTY 1.2.0.1096 on the SHA-256 allow-list. Other builds are status-only.</sys:String>
    <sys:String x:Key="Implementation">Implementation</sys:String>
    <sys:String x:Key="ImplementationText">External x86 utility using Win32 process-memory APIs and short remote code thunks to call the game’s own object-creation functions. No DLL injection, EXE edits, or Steam/DRM bypass.</sys:String>
    <sys:String x:Key="References">References &amp; acknowledgements</sys:String>
    <sys:String x:Key="ReferencesText">Advanced Pause is a long-established PvZ community term with no verifiable sole inventor. Research consulted PVZ Wiki, AsmVsZombies, PvZ Toolkit, and PvZ-Portable; see docs/REFERENCES.md.</sys:String>
    <sys:String x:Key="Artwork">Original artwork</sys:String>
    <sys:String x:Key="ArtworkText">The sprout mechanic was generated with OpenAI image generation from this project’s prompt and processed for clean transparency. No official game artwork is included.</sys:String>
    <sys:String x:Key="OpenRepository">Open project folder</sys:String>
    <sys:String x:Key="OpenReferences">Read references</sys:String>
    <sys:String x:Key="LicenseText">GPL-3.0-only · Unofficial fan project · A legally obtained game copy is required</sys:String>

    <sys:String x:Key="ErrorVersionMismatch">Executable hash is not on the 1.0 allow-list. Memory writes were blocked.</sys:String>
    <sys:String x:Key="ErrorPatchMismatch">Original bytes at the target address do not match. The operation was cancelled for safety.</sys:String>
    <sys:String x:Key="ErrorGameClosed">The game process has closed.</sys:String>
    <sys:String x:Key="ErrorSaveNotFound">No save directory was found.</sys:String>
    <sys:String x:Key="ErrorGameMustClose">Close the game before restoring a save.</sys:String>
    <sys:String x:Key="ErrorAdvancedPauseUnavailable">The Steam 1096 Advanced Pause runtime signature has not been verified. This feature is safely disabled and will not guess or write an unknown address.</sys:String>
    <sys:String x:Key="ErrorChallengeUnavailable">The Steam 1096 challenge-rule object transaction has not completed live verification. Background writes are safely disabled in this candidate.</sys:String>
    <sys:String x:Key="ErrorRuntimeSignature">A runtime signature or structure check failed; the write was blocked.</sys:String>
    <sys:String x:Key="ErrorPatchBusy">Another tool already enabled this patch; Plus One Trainer will not take ownership or overwrite it.</sys:String>
    <sys:String x:Key="ErrorPatchOwnership">Patch bytes changed externally; Plus One Trainer refused to overwrite them.</sys:String>
    <sys:String x:Key="ErrorRemoteBusy">A previous internal game call is still running; the new call was blocked.</sys:String>
    <sys:String x:Key="ErrorRemoteTimeout">An internal game call timed out; the safety guard stays owned until it exits.</sys:String>
    <sys:String x:Key="ErrorAdventureRequired">Complete Adventure once before revealing the Limbo Page.</sys:String>
    <sys:String x:Key="ErrorBobsledUnavailable">Bobsled Team creates four zombies at once. This candidate blocks forced placement until all four can be tracked and cleared safely. Other IDs 0–32 remain available under their guardrails.</sys:String>
    <sys:String x:Key="ErrorInvalidNumericSettings">Invalid numeric settings. Check the multipliers, start index, and maximum.</sys:String>
    <sys:String x:Key="RemoteCleanupWaiting">Waiting for the internal game call to finish and restoring its guard. Do not force-close the trainer.</sys:String>
</ResourceDictionary>
