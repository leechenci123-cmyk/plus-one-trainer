<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppName">+1 修改器</sys:String>
    <sys:String x:Key="AppTagline">把麻烦减一，把顺手加一</sys:String>
    <sys:String x:Key="VersionLabel">1.0 Beta 2</sys:String>
    <sys:String x:Key="NavConvenience">⌂  方便功能</sys:String>
    <sys:String x:Key="NavChallenge">⚑  挑战设置</sys:String>
    <sys:String x:Key="NavModes">▦  隐藏模式</sys:String>
    <sys:String x:Key="NavLab">⚗  测试工坊</sys:String>
    <sys:String x:Key="NavCheats">✦  作弊功能</sys:String>
    <sys:String x:Key="NavVault">▣  存档保险箱</sys:String>
    <sys:String x:Key="NavSettings">⚙  设置与关于</sys:String>

    <sys:String x:Key="StatusSearching">正在寻找游戏…</sys:String>
    <sys:String x:Key="StatusNotRunning">游戏未运行</sys:String>
    <sys:String x:Key="StatusAttached">已连接 · Steam GOTY 1.2.0.1096</sys:String>
    <sys:String x:Key="StatusUnsupported">发现游戏，但版本不在安全白名单</sys:String>
    <sys:String x:Key="StatusReadOnly">只读保护</sys:String>
    <sys:String x:Key="AttachNow">重新检测</sys:String>
    <sys:String x:Key="GameNeeded">请先启动 Plants vs. Zombies。</sys:String>
    <sys:String x:Key="BattleNeeded">此功能只能在战斗画面使用。</sys:String>
    <sys:String x:Key="Success">完成</sys:String>
    <sys:String x:Key="Failed">操作失败</sys:String>
    <sys:String x:Key="Confirm">确认</sys:String>
    <sys:String x:Key="Cancel">取消</sys:String>

    <sys:String x:Key="HomeTitle">先把游戏变顺手</sys:String>
    <sys:String x:Key="HomeSubtitle">常用功能都在第一层；数值作弊放在后面，需要时再开。</sys:String>
    <sys:String x:Key="AdvancedPauseTitle">高级暂停</sys:String>
    <sys:String x:Key="AdvancedPauseDescription">目标行为：冻结战场，同时保留选卡、种植、铲除与玉米炮操作。Steam 1096 的唯一运行时签名尚待实机验证，1.0 候选版会安全禁用，绝不猜地址。</sys:String>
    <sys:String x:Key="AdvancedPauseOn">解除高级暂停</sys:String>
    <sys:String x:Key="AdvancedPauseOff">等待签名验证</sys:String>
    <sys:String x:Key="AdvancedPauseBadge">待实机验证 · 禁止写入</sys:String>
    <sys:String x:Key="SpeedTitle">游戏速度</sys:String>
    <sys:String x:Key="SpeedDescription">只改变游戏帧时长；1.0× 是原速。</sys:String>
    <sys:String x:Key="ApplySpeed">应用速度</sys:String>
    <sys:String x:Key="ResetSpeed">恢复原速</sys:String>
    <sys:String x:Key="AutoCollect">自动收集阳光、金币、钻石、巧克力与礼物</sys:String>
    <sys:String x:Key="PauseOnFocusLoss">切出游戏时自动高级暂停（待验证）</sys:String>
    <sys:String x:Key="ConvenienceTitle">顺手开关</sys:String>
    <sys:String x:Key="HealthBarsTitle">场上血条</sys:String>
    <sys:String x:Key="HealthBarsDescription">在每株植物与每只僵尸上方显示耐久；僵尸血条会随移动位置更新。仅在游戏位于前台且正在战斗时出现。</sys:String>
    <sys:String x:Key="HealthBarsReadOnly">外部只读覆盖层 · 不修改血量</sys:String>
    <sys:String x:Key="HealthBarsEnabled">显示血条</sys:String>
    <sys:String x:Key="ZombieHealthBars">僵尸血条（跟随移动）</sys:String>
    <sys:String x:Key="PlantHealthBars">植物血条</sys:String>
    <sys:String x:Key="HotkeysTitle">快捷键</sys:String>
    <sys:String x:Key="HotkeyF3">F3　高级暂停（验证通过后启用）</sys:String>
    <sys:String x:Key="HotkeyF4">F4　原速 / 上次速度</sys:String>
    <sys:String x:Key="HotkeyF8">F8　立即备份存档</sys:String>
    <sys:String x:Key="SafetyTitle">安全护栏已开启</sys:String>
    <sys:String x:Key="SafetyDescription">只对白名单版本写入；危险操作前自动备份；退出时恢复代码补丁；从不修改游戏 EXE。</sys:String>

    <sys:String x:Key="ChallengeTitle">按你的尺度增加难度</sys:String>
    <sys:String x:Key="ChallengeSubtitle">可用于一周目、多周目、生存和无尽。护甲与本体遵循同一耐久倍率。</sys:String>
    <sys:String x:Key="DifficultyEnabled">启用挑战规则</sys:String>
    <sys:String x:Key="SpawnCount">刷怪数量倍率</sys:String>
    <sys:String x:Key="SpawnCountHint">1.0–10.0；小数部分按波均匀补足。</sys:String>
    <sys:String x:Key="SpawnSpeed">出怪速度倍率</sys:String>
    <sys:String x:Key="SpawnSpeedHint">只调整波次推进，不改变整个游戏速度。</sys:String>
    <sys:String x:Key="Durability">僵尸耐久倍率</sys:String>
    <sys:String x:Key="DurabilityHint">同时覆盖本体、头盔、盾牌及飞行耐久。</sys:String>
    <sys:String x:Key="ApplyChallenge">应用挑战规则</sys:String>
    <sys:String x:Key="AdvancedSettings">高级设置（三级）</sys:String>
    <sys:String x:Key="GrowthUnit">增长时机</sys:String>
    <sys:String x:Key="GrowthNone">不增长</sys:String>
    <sys:String x:Key="GrowthWave">每波</sys:String>
    <sys:String x:Key="GrowthFlag">每旗（10 波）</sys:String>
    <sys:String x:Key="GrowthSelection">每次选卡（20 波 / 2 旗）</sys:String>
    <sys:String x:Key="GrowthLevel">每关</sys:String>
    <sys:String x:Key="GrowthFormula">增长方式</sys:String>
    <sys:String x:Key="FormulaAdd">固定增加</sys:String>
    <sys:String x:Key="FormulaPercent">百分比增加</sys:String>
    <sys:String x:Key="FormulaMultiply">乘法增长</sys:String>
    <sys:String x:Key="GrowthStep">每次增长值</sys:String>
    <sys:String x:Key="GrowthStarts">从第几次开始</sys:String>
    <sys:String x:Key="GrowthCap">倍率上限</sys:String>
    <sys:String x:Key="ResetAtLevel">新关卡重置增长</sys:String>
    <sys:String x:Key="ChallengeRuntimeNote">Steam 1096 的安全对象事务仍待实机验证；候选版暂时禁用挑战规则写入。计算与界面已保留，验证通过后再启用。</sys:String>

    <sys:String x:Key="ModesTitle">原版藏着的另一页</sys:String>
    <sys:String x:Key="ModesSubtitle">完成冒险一周目后，可把原版 Limbo Page 显示出来。不会改存档解锁进度。</sys:String>
    <sys:String x:Key="UnlockLimbo">显示 Limbo Page</sys:String>
    <sys:String x:Key="LockLimbo">恢复隐藏</sys:String>
    <sys:String x:Key="LimboHow">启用后返回游戏主菜单，进入小游戏/生存选择页即可看到额外入口。</sys:String>
    <sys:String x:Key="StableModes">原版隐藏、较稳定</sys:String>
    <sys:String x:Key="StableModesList">白天无尽 · 黑夜无尽 · 浓雾无尽 · 屋顶无尽 · Limbo 小游戏</sys:String>
    <sys:String x:Key="OfficialPool">泳池无尽本来就在正常生存页面。</sys:String>
    <sys:String x:Key="PuzzleInfo">砸罐子与我是僵尸的 1–9 关及无尽都属于正常 Puzzle 页面，不是另一张隐藏页。</sys:String>
    <sys:String x:Key="ExperimentalModes">实验模式</sys:String>
    <sys:String x:Key="NightRoof">夜晚屋顶无尽</sys:String>
    <sys:String x:Key="NightRoofDescription">原版没有完整的 NIGHT_ROOF_ENDLESS 模式。这是场景混合实验，不冒充“原版隐藏关”。</sys:String>
    <sys:String x:Key="ApplyNightRoof">在屋顶无尽中切换夜晚屋顶</sys:String>
    <sys:String x:Key="InternalModes">内部/未完成条目</sys:String>
    <sys:String x:Key="InternalModesDescription">Ice Level、Zen Garden 模式、Squirrel、Intro、Upsell 等可能无法通关或闪退；1.0 默认不提供一键进入。</sys:String>

    <sys:String x:Key="LabTitle">测试工坊</sys:String>
    <sys:String x:Key="LabSubtitle">像“我是僵尸”一样放置测试对象；自动检查战斗状态、行数与特殊僵尸风险。</sys:String>
    <sys:String x:Key="RemoteCallsBeta2Note">Beta 2 已连接正版 Steam 包装环境，但放僵尸、扶梯与夜晚屋顶依赖尚未验证的游戏内部调用，因此继续禁用。血条、速度、自动收集和常规作弊可先测试。</sys:String>
    <sys:String x:Key="ZombieSpawner">放置僵尸</sys:String>
    <sys:String x:Key="ZombieType">僵尸类型</sys:String>
    <sys:String x:Key="Row">行</sys:String>
    <sys:String x:Key="Column">列</sys:String>
    <sys:String x:Key="SpawnZombie">放置一只</sys:String>
    <sys:String x:Key="BossWarning">僵王无视行列且只能有一只；工具只允许在原版最终 Boss 战生成。雪橇队会原生创建四个对象，候选版暂时拒绝强放。</sys:String>
    <sys:String x:Key="LadderTool">独立扶梯</sys:String>
    <sys:String x:Key="LadderDescription">这里放的是地图上的扶梯，不是扶梯僵尸。只允许放到核桃、高坚果或南瓜所在格。</sys:String>
    <sys:String x:Key="PlaceLadder">在目标格放扶梯</sys:String>
    <sys:String x:Key="ClearLabObjects">清除本次生成对象</sys:String>
    <sys:String x:Key="ClearLabHint">只清除由本工具在当前连接中生成的僵尸与扶梯，不会清场。</sys:String>
    <sys:String x:Key="InvalidLadderCell">目标格没有存活的核桃、高坚果或南瓜。</sys:String>
    <sys:String x:Key="BossConfirmTitle">确认生成僵王</sys:String>
    <sys:String x:Key="BossConfirmText">这会先备份存档。僵王依赖特殊关卡脚本，在普通场景可能导致闪退。仍要生成一只吗？</sys:String>

    <sys:String x:Key="CheatsTitle">作弊功能</sys:String>
    <sys:String x:Key="CheatsSubtitle">这些不是日常便利，因此放在第二层。每个开关都可单独恢复。</sys:String>
    <sys:String x:Key="SunAmount">阳光数值</sys:String>
    <sys:String x:Key="SetSun">设置阳光</sys:String>
    <sys:String x:Key="NoCooldown">卡片无冷却</sys:String>
    <sys:String x:Key="FreePlanting">种植不消耗阳光</sys:String>
    <sys:String x:Key="PlantInvincible">植物无敌（完整伤害来源）</sys:String>
    <sys:String x:Key="MushroomsAwake">白天蘑菇不睡觉</sys:String>
    <sys:String x:Key="UnlockSunLimit">解除 9990 阳光上限</sys:String>
    <sys:String x:Key="CheatWarning">退出修改器时会尽力恢复代码补丁；游戏异常关闭时补丁随进程消失。</sys:String>

    <sys:String x:Key="VaultTitle">存档保险箱</sys:String>
    <sys:String x:Key="VaultSubtitle">不编辑账号内容，只做可校验的整目录备份与恢复。</sys:String>
    <sys:String x:Key="SaveLocation">检测到的存档目录</sys:String>
    <sys:String x:Key="BackupNow">立即创建备份</sys:String>
    <sys:String x:Key="OpenVault">打开保险箱目录</sys:String>
    <sys:String x:Key="RefreshBackups">刷新列表</sys:String>
    <sys:String x:Key="RestoreBackup">恢复选中备份</sys:String>
    <sys:String x:Key="NoBackups">还没有备份。</sys:String>
    <sys:String x:Key="RestoreWarning">恢复前必须关闭游戏；工具会先再备份一次当前存档。</sys:String>
    <sys:String x:Key="RestoreConfirmTitle">确认恢复存档</sys:String>
    <sys:String x:Key="RestoreConfirmText">将把备份中的文件复制到当前存档；当前目录里不属于该快照的额外文件会保留。工具会先保存一份“恢复前”快照。继续吗？</sys:String>
    <sys:String x:Key="BackupComplete">存档备份已创建。</sys:String>
    <sys:String x:Key="RestoreComplete">快照中的文件已恢复，文件哈希校验通过。</sys:String>

    <sys:String x:Key="SettingsTitle">设置与关于</sys:String>
    <sys:String x:Key="SettingsSubtitle">语言、安全策略、兼容版本与公开来源。</sys:String>
    <sys:String x:Key="Language">界面语言</sys:String>
    <sys:String x:Key="Chinese">简体中文</sys:String>
    <sys:String x:Key="English">English</sys:String>
    <sys:String x:Key="Compatibility">兼容性</sys:String>
    <sys:String x:Key="CompatibilityText">Beta 2 支持同一 SHA-256 白名单下的 Steam GOTY 1.2.0.1096 英文版，以及正版 Steam 包装运行时间戳 0x48ECEE74；仍须通过运行时对象检查。</sys:String>
    <sys:String x:Key="Implementation">实现方式</sys:String>
    <sys:String x:Key="ImplementationText">外部 x86 工具；使用 Win32 进程内存 API 与短暂远程代码片段调用游戏自身对象创建函数。不注入 DLL，不修改 EXE，不绕过 Steam/DRM。</sys:String>
    <sys:String x:Key="References">参考与致谢</sys:String>
    <sys:String x:Key="ReferencesText">高级暂停是 PVZ 社区长期使用的技术名称，目前没有可核验的单一首创者。资料参考 PVZ Wiki、AsmVsZombies、PvZ Toolkit 与 PvZ-Portable；详情见 docs/REFERENCES.md。</sys:String>
    <sys:String x:Key="Artwork">原创美术</sys:String>
    <sys:String x:Key="ArtworkText">嫩芽机械师由 OpenAI 图像生成工具按本项目提示词生成并经透明边缘处理；不包含游戏官方素材。</sys:String>
    <sys:String x:Key="OpenRepository">打开项目目录</sys:String>
    <sys:String x:Key="OpenReferences">查看参考文档</sys:String>
    <sys:String x:Key="LicenseText">GPL-3.0-only · 非官方爱好者项目 · 需自行合法拥有游戏</sys:String>

    <sys:String x:Key="ErrorVersionMismatch">可执行文件哈希与 1.0 白名单不符，已阻止写入。</sys:String>
    <sys:String x:Key="ErrorPatchMismatch">目标地址的原始字节不符。为避免损坏，操作已取消。</sys:String>
    <sys:String x:Key="ErrorGameClosed">游戏进程已关闭。</sys:String>
    <sys:String x:Key="ErrorSaveNotFound">没有找到存档目录。</sys:String>
    <sys:String x:Key="ErrorGameMustClose">恢复存档前请先关闭游戏。</sys:String>
    <sys:String x:Key="ErrorAdvancedPauseUnavailable">高级暂停的 Steam 1096 运行时签名尚未验证。此功能已安全禁用，不会猜测或写入未知地址。</sys:String>
    <sys:String x:Key="ErrorChallengeUnavailable">挑战规则的 Steam 1096 对象事务尚未完成实机验证。候选版已安全禁用后台写入。</sys:String>
    <sys:String x:Key="ErrorRuntimeSignature">运行时签名或结构检查失败，写入已阻止。</sys:String>
    <sys:String x:Key="ErrorPatchBusy">目标补丁已由其他工具启用，本修改器不会接管或覆盖。</sys:String>
    <sys:String x:Key="ErrorPatchOwnership">补丁字节已被外部改变，本修改器拒绝覆盖。</sys:String>
    <sys:String x:Key="ErrorRemoteBusy">上一次游戏内部调用仍在执行，新的调用已阻止。</sys:String>
    <sys:String x:Key="ErrorRemoteTimeout">游戏内部调用超时；工具会保留安全护栏并等待它结束。</sys:String>
    <sys:String x:Key="ErrorRemoteCallsUnavailable">Beta 2 尚未验证正版 Steam 包装环境中的游戏内部函数，因此测试工坊与夜晚屋顶保持禁用。</sys:String>
    <sys:String x:Key="ErrorAdventureRequired">完成冒险模式一周目后才可显示 Limbo Page。</sys:String>
    <sys:String x:Key="ErrorBobsledUnavailable">雪橇队会一次创建四只僵尸；Beta 2 禁用全部内部生成调用，后续版本还须能可靠追踪并只清除这四只后才会开放。</sys:String>
    <sys:String x:Key="ErrorInvalidNumericSettings">数值设置无效，请检查倍率、起始值与上限。</sys:String>
    <sys:String x:Key="RemoteCleanupWaiting">正在等待游戏内部调用安全结束并恢复护栏，请勿强制关闭。</sys:String>
</ResourceDictionary>
